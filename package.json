{
  "name": "auto-tracker",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write src *.ts *.js *.cjs *.json .prettierrc",
    "format:check": "prettier --check src *.ts *.js *.cjs *.json .prettierrc",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "pipeline": "tsx --env-file=.env scripts/run.ts",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run arch && npm run test:coverage"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@google/model-viewer": "^4.4.0",
    "lottie-web": "^5.13.0",
    "lucide-react": "^1.61.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2.0.5",
    "dependency-cruiser": "^16.3.10",
    "eslint": "^9.9.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.9.0",
    "prettier": "^3.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.2.0",
    "vite": "^5.4.2",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.0.5"
  }
}
